/* Full-width terminal workspace, with text branding and centered shortcuts. */
Screen { background: $background; }
#logo {
    width: 100%; height: auto; padding: 1 2 0 2; text-align: center;
}
#status-line {
    height: 1; margin: 1 2 0 2; color: $text-muted; text-align: center;
    text-wrap: nowrap; text-overflow: ellipsis;
}
#tabs {
    height: 2; margin: 1 2 0 2; border-bottom: solid $panel;
    link-style: none; link-color: $text-muted;
    link-background: $background; link-color-hover: $primary;
    link-style-hover: bold; link-background-hover: $panel;
}
#panes, #pane-download, FilesPane { height: 1fr; }
.source-row {
    height: 3; margin: 1 2 0 2; border: solid $panel;
    border-title-color: $text-muted; border-title-style: bold;
}
.source-row:focus-within { border: solid $primary; border-title-color: $primary; }
.prompt { width: 2; padding-left: 1; color: $primary; text-style: bold; }
#url, #file-input {
    width: 1fr; height: 1; border: none; padding: 0 1; background: $background;
}
#url:focus, #file-input:focus { border: none; }
Input:focus { background-tint: $foreground 0%; }
MainScreen.-narrow #thumb { display: none; }
MainScreen.-compact #action-hint, MainScreen.-compact #files-hint { display: none; }
MainScreen.-short #logo { display: none; }
MainScreen.-short #status-line { margin-top: 0; }
MainScreen.-short #tabs { margin-top: 0; height: 1; border: none; }
MainScreen.-short #video-title { margin-bottom: 0; }
MainScreen.-short #video-meta { margin-bottom: 0; }
MainScreen.-short VideoCard { margin-top: 1; padding-top: 0; }
MainScreen.-short #thumb { display: none; }
MainScreen.-short #actions Button { height: 1; border: none; }

/* ---------- section rules ---------- */

VideoCard, DownloadQueue, #files-card {
    margin: 1 2 0 2;
    padding: 1 0 0 0;
    border: none;
    border-top: solid $panel;
    border-title-align: left;
    border-title-style: bold;
    background: $background;
}

/* ---------- video card ---------- */

VideoCard {
    height: auto;
    border-title-color: $primary;
}

#files-card {
    height: auto;
    max-height: 50%;
    border-title-color: $primary;
}

#files-empty, #files-status {
    height: auto;
    color: $text-muted;
}

#files {
    height: auto;
    max-height: 12;
    border: none;
    padding: 0;
    background: $background;
    margin-bottom: 1;
}

#files:focus {
    border: none;
    background-tint: $foreground 0%;
}

#files-hint {
    width: auto;
    color: $text-muted;
}

#card-switcher {
    height: auto;
}

#card-empty {
    height: auto;
    color: $text-muted;
}

#card-loading {
    height: 1;
}

#card-loading LoadingIndicator {
    width: 8;
    height: 1;
    color: $primary;
}

#loading-text {
    width: auto;
    color: $text-muted;
}

#card-error {
    height: auto;
}

#error-hint {
    margin: 1 0;
    color: $text-muted;
}

#card-info {
    height: auto;
}

#thumb {
    margin-right: 3;
}

#details {
    height: auto;
    width: 1fr;
}

#video-title {
    color: $text;
    text-style: bold;
    margin-bottom: 1;
}

#video-meta {
    margin-bottom: 1;
}

#action-hint {
    width: auto;
    height: 3;
    margin-left: 2;
    content-align: left middle;
    color: $text-muted;
}

/* Buttons: the border never changes, so hover and focus can't shift the layout.
   Idle is an outline, hover warms the outline, focus fills, a press darkens. */

Button, Button.-primary, Button.-success, Button.-default {
    width: auto;
    min-width: 14;
    height: 3;
    padding: 0 2;
    margin: 0;
    content-align: center middle;
    border: round $panel;
    background: $background;
    color: $foreground;
    text-style: none;
    tint: transparent;
}
Button:hover, Button.-primary:hover, Button.-success:hover, Button.-default:hover {
    border: round $primary;
    background: $panel 40%;
    color: $primary;
    text-style: bold;
}
Button:focus, Button.-primary:focus, Button.-success:focus, Button.-default:focus {
    border: round $primary;
    background: $primary;
    color: auto 90%;
    text-style: bold;
}
Button.-active, Button.-active:hover, Button.-active:focus {
    border: round $primary-darken-1;
    background: $primary-darken-1;
    color: auto 90%;
}
Button:disabled {
    border: round $panel;
    background: $background;
    color: $text-muted;
    text-style: dim;
}

#cancel { color: $text-muted; }
#cancel:hover { border: round $error; color: $error; }
#cancel:focus { border: round $error; background: $error; color: auto 90%; }

#error-actions, #actions, #dialog-actions, #files-actions {
    height: auto;
}

#error-actions Button, #actions Button, #dialog-actions Button, #files-actions Button {
    margin-right: 2;
}
#error-actions Button:last-of-type, #actions Button:last-of-type,
#dialog-actions Button:last-of-type, #files-actions Button:last-of-type { margin-right: 0; }

/* ---------- download list ---------- */

DownloadQueue {
    height: 1fr;
    min-height: 5;
    border-title-color: $primary;
    scrollbar-size-vertical: 1;
}

.queue-empty {
    color: $text-muted;
}

JobRow {
    padding: 0 0 1 0;
}

.job-head {
    height: 1;
}

.job-mark {
    width: 2;
    color: $text-muted;
    text-style: bold;
}

JobRow.-running .job-mark {
    color: $primary;
}

JobRow.-done .job-mark {
    color: $success;
}

JobRow.-failed .job-mark {
    color: $error;
}

.job-title {
    width: 1fr;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.job-kind {
    width: auto;
    color: $primary;
    margin-left: 2;
}

.job-cancel {
    margin-left: 2;
    color: $text-muted;
}

JobRow .job-cancel:focus {
    background: $error;
    color: auto 90%;
}

.job-body {
    height: 1;
    padding-left: 2;
}

JobRow BlockBar {
    width: 30;
    color: $primary;
}

JobRow BlockBar > .block-bar--track {
    color: $panel;
}

JobRow.-done BlockBar {
    color: $success;
}

JobRow.-failed BlockBar, JobRow.-cancelled BlockBar {
    color: $panel;
}

.job-status {
    margin-left: 2;
    width: 1fr;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#download, #go, #save, #convert-files {
    background: $primary; color: auto 90%; border: round $primary; text-style: bold;
}
#download:hover, #go:hover, #save:hover, #convert-files:hover {
    background: $primary-lighten-1; color: auto 90%; border: round $primary-lighten-1;
}
#download:focus, #go:focus, #save:focus, #convert-files:focus {
    background: $primary; color: auto 90%; border: round $foreground;
}
#thumb { width: 34; height: 9; }
.job-cancel { height: 1; min-width: 0; border: none; padding: 0 1; }
.job-cancel:hover { background: $panel; color: $error; }
JobRow BlockBar { width: 24; }
#video-meta { color: $text; }

/* ---------- key bar ---------- */

#keys {
    dock: bottom;
    text-align: center;
    height: auto;
    min-height: 2;
    max-height: 4;
    padding: 0 2;
    border-top: solid $panel;
    background: $background;
    text-wrap: wrap;
    link-style: none;
    link-color: $text-muted;
    link-background: $background;
    link-style-hover: bold;
    link-color-hover: $primary;
    link-background-hover: $panel;
}

/* ---------- dialogs ---------- */

ModalScreen {
    align: center middle;
    background: $background 70%;
}

#dialog {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 95%;
    padding: 1 2;
    overflow-y: auto;
    border: solid $primary;
    background: $background;
}

#dialog.cookies {
    width: 60;
}

#dialog.picker-dialog {
    width: 80;
    height: 32;
}

#tree {
    height: 1fr;
    background: $background;
}

#dialog.sites {
    width: 64;
    height: 30;
}

#site-search {
    border: solid $panel;
    background: $background;
}

#site-search:focus {
    border: solid $primary;
}

#site-result {
    height: 1;
    margin: 1 0;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#sites {
    height: 1fr;
}

#dialog-title {
    margin-bottom: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#dialog-actions {
    margin-top: 1;
}

#kind {
    height: auto;
}

.pickers {
    height: auto;
    padding-top: 1;
}

.picker {
    width: 1fr;
    height: auto;
}

.picker:first-of-type {
    margin-right: 2;
}

.picker-label, .field-label {
    color: $text-muted;
    margin-bottom: 0;
}

.field-label {
    margin-top: 1;
}

.picker OptionList {
    height: 10;
}

#summary {
    margin: 1 0 0 0;
}

#folder-row {
    height: auto;
}

#folder {
    width: 1fr;
    border: solid $panel;
    background: $background;
}

#folder:focus {
    border: solid $primary;
}

#browse {
    margin: 1 0 0 1;
}

#tree {
    height: 12;
    border: solid $panel;
    background: $background;
}

#folder-error {
    height: auto;
}

#cookies {
    width: 40;
}

#cookies-note {
    margin: 1 0;
}

#browsers {
    height: auto;
    max-height: 10;
    margin: 1 0;
    border: solid $panel;
    background: $background;
}

/* ---------- lists, tabs, selects: grey at rest, one solid accent chip on focus ---------- */

OptionList {
    border: solid $panel;
    background: $background;
    scrollbar-size-vertical: 1;
    scrollbar-background: $background;
    scrollbar-background-hover: $background;
    scrollbar-background-active: $background;
    scrollbar-color: $panel;
    scrollbar-color-hover: $primary;
    scrollbar-color-active: $primary;
    scrollbar-corner-color: $background;
}

OptionList:focus {
    border: solid $primary;
    background-tint: $foreground 0%;
}

OptionList > .option-list--option-highlighted {
    color: $foreground;
    background: $panel;
    text-style: bold;
}

OptionList:focus > .option-list--option-highlighted {
    color: auto 90%;
    background: $primary;
    text-style: bold;
}

OptionList > .option-list--option-hover {
    background: $panel;
}

Tabs Tab {
    color: $text-muted;
    background: $background;
}

Tabs Tab.-active {
    color: $primary;
    text-style: bold;
}

Tabs:focus Tab.-active {
    color: auto 90%;
    background: $primary;
}

Tabs Underline > .underline--bar {
    color: $primary;
    background: $panel;
}

Select > SelectCurrent {
    border: solid $panel;
    background: $background;
}

Select:focus > SelectCurrent {
    border: solid $primary;
    background-tint: $foreground 0%;
}

Select > SelectOverlay {
    border: solid $primary;
}

/* A compact terminal keeps the input, media actions and queue in view. */
MainScreen.-short DownloadQueue { min-height: 3; padding-top: 0; }
MainScreen.-short #files-card { padding-top: 0; margin-top: 1; }
MainScreen.-short #files { max-height: 5; }
MainScreen.-short #files-actions Button { height: 1; border: none; }
#error-hint { max-height: 5; overflow-y: auto; }

/* ---------- frames: soft rounded borders on inputs and dialogs ---------- */

.source-row { border: round $panel; }
.source-row:focus-within { border: round $primary; }
#dialog { border: round $primary; }

MainScreen.-short #actions Button, MainScreen.-short #files-actions Button {
    height: 1; min-width: 10; border: none; padding: 0 2;
}

/* Action buttons are solid three-row fills with the label centred. No border glyphs: half-block
   borders leave gaps in many terminal fonts. The primary action is filled with the accent;
   the rest sit on a quiet panel. Text on a fill is `auto`, black or white for contrast. */
#actions Button, #files-actions Button, #error-actions Button, #dialog-actions Button {
    height: 3; min-width: 0; padding: 0 4; border: none; text-style: bold;
    background: $panel; color: auto 87%;
}
#actions Button:hover, #files-actions Button:hover,
#error-actions Button:hover, #dialog-actions Button:hover {
    border: none; background: $panel-lighten-1; color: $primary;
}
#actions Button:focus, #files-actions Button:focus,
#error-actions Button:focus, #dialog-actions Button:focus {
    border: none; background: $primary; color: auto 90%; text-style: bold underline;
}
#actions #download, #files-actions #convert-files, #dialog-actions #go, #dialog-actions #save {
    border: none; background: $primary; color: auto 90%;
}
#actions #download:hover, #files-actions #convert-files:hover,
#dialog-actions #go:hover, #dialog-actions #save:hover {
    border: none; background: $primary-lighten-1; color: auto 90%;
}
#actions #download:focus, #files-actions #convert-files:focus,
#dialog-actions #go:focus, #dialog-actions #save:focus {
    border: none; background: $primary-lighten-1; color: auto 90%;
    text-style: bold underline;
}
#dialog-actions #cancel:hover { border: none; color: $error; }
#dialog-actions #cancel:focus { border: none; background: $error; color: auto 90%; }
#action-hint { height: 3; }
MainScreen.-short #actions Button, MainScreen.-short #files-actions Button {
    height: 1 !important; border: none !important;
}
MainScreen.-short #action-hint { height: 1; }
